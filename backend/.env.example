# Ortam
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Veritabani
DATABASE_URL=sqlite+aiosqlite:///./data/umtalagent.db

# CORS (virgulle ayrilmis)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Anahtarlari (YALNIZCA backend'de tutulmalidir)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Guvenlik Limitleri
MAX_TOKENS_PER_REQUEST=2048
MAX_HISTORY_MESSAGES=30

# Ajan Yapilandirma Dosyasi
AGENTS_CONFIG_PATH=./agents/agents.yaml
SOULS_DIR=./agents/souls