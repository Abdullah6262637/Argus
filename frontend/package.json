{
  "name": "argus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Argus - Aynı anda her şeyi gören çoklu ajan sistemi",
  "author": "Argus",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "electron": "node electron/launcher.cjs",
    "backend:dev": "node -e \"const { spawn } = require('child_process'); const path = require('path'); const fs = require('fs'); const backendDir = path.resolve(__dirname, '..', 'backend'); const venvPy = path.resolve(__dirname, '..', '.venv', 'Scripts', 'python.exe'); const py = fs.existsSync(venvPy) ? venvPy : 'python'; const proc = spawn(py, ['-m', 'uvicorn', 'app.main:app', '--host', '127.0.0.1', '--port', '8000'], { cwd: backendDir, stdio: 'inherit' }); proc.on('exit', c => process.exit(c || 0));\"",
    "electron:dev": "cross-env ARGUS_NO_BACKEND=1 concurrently -k -n BACKEND,VITE,ELECTRON -c green,cyan,magenta \"npm run backend:dev\" \"npm run dev\" \"wait-on http-get://127.0.0.1:5173 http-get://127.0.0.1:8000/api/health && node electron/launcher.cjs\"",
    "electron:only": "cross-env ARGUS_NO_BACKEND=1 node electron/launcher.cjs",
    "electron:build": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.argus.desktop",
    "productName": "Argus",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/argus-backend",
        "to": "backend/argus-backend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/agents",
        "to": "backend/agents",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "electron/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Argus"
    },
    "publish": {
      "provider": "github",
      "owner": "argus-team",
      "repo": "argus",
      "releaseType": "release"
    }
  }
}
